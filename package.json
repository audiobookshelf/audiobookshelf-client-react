{
  "name": "audiobookshelf-client-react",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "sync-pdfjs": "node scripts/sync-pdfjs-vendor.mjs",
    "sync-unrar": "node scripts/sync-unrar-wasm.mjs",
    "migrate-locales": "node scripts/migrate-locales-from-vue.mjs",
    "migrate-locales:dry": "node scripts/migrate-locales-from-vue.mjs --dry-run",
    "postinstall": "node scripts/sync-pdfjs-vendor.mjs && node scripts/sync-unrar-wasm.mjs",
    "find-hardcoded-strings": "node scripts/find-hardcoded-strings.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "check": "pnpm lint && pnpm typecheck && pnpm find-hardcoded-strings",
    "dev": "next dev",
    "build": "node scripts/sync-pdfjs-vendor.mjs && node scripts/sync-unrar-wasm.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "cy:open": "cypress open",
    "cy:comp": "cypress open --component --browser chrome",
    "test": "cypress run --component --browser chrome",
    "test:spec": "cypress run --component --browser chrome --spec",
    "cy:brave": "cypress open --component --browser \"C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe:chrome\"",
    "test:brave": "cypress run --component --browser \"C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe:chrome\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.6",
    "clsx": "^2.1.1",
    "cronstrue": "^3.3.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "foliate-js": "github:audiobookshelf/foliate-js#abs-1.0.0",
    "hls.js": "^1.6.15",
    "marked": "^18.0.5",
    "next": "^16.3.8",
    "next-intl": "^4.12.0",
    "node-unrar-js": "^2.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-transition-group": "^4.4.5",
    "slate": "^0.118.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.117.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "cypress": "^15.21.1",
    "cypress-plugin-tab": "^1.0.5",
    "cypress-real-events": "^1.15.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^12.0.0"
  }
}
